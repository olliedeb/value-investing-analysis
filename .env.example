# Copy to info.env and fill in your values. info.env is git-ignored --
# never commit real credentials.
#
#   cp .env.example info.env

# MySQL / MariaDB connection (db.py reads these)
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=localhost

# The SEC requires a contact identifier on every EDGAR request, e.g.
# "Jane Doe jane@example.com". Use your real name and email.
SEC_USER_AGENT=
